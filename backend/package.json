{
    "name": "@fleet-management/backend",
    "version": "1.92.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start": "node --trace-warnings dist/app.js",
        "start:clean": "node --trace-warnings dist/app.js --wipe-components=1",
        "build": "tsc",
        "watch": "tsc -w",
        "test": "node --import tsx --import ./test/_runtimeMetadataEnv.ts --test \"test/**/*.test.ts\"",
        "test:integration": "node --import tsx --import ./test/_runtimeMetadataEnv.ts --test --test-global-setup=./test/integration/_setup.ts --test-concurrency=1 \"test/integration/**/*.integration.ts\"",
        "test:snapshot-e2e": "node --import tsx --import ./test/_runtimeMetadataEnv.ts --test --test-global-setup=./test/integration/_setup.ts --test-concurrency=1 test/integration/deviceSnapshotPipeline.integration.ts",
        "test:em-sync-60day": "FM_RUN_EM_60DAY_SCALE=1 FM_EM_60DAY_FLEETS=${FM_EM_60DAY_FLEETS:-1000,2000} FM_EM_60DAY_NEW_DEVICE_PERCENT=${FM_EM_60DAY_NEW_DEVICE_PERCENT:-50} FM_REDIS_TEST_MAX_MEMORY=1gb FM_EMSYNC_STREAM_MAXLEN=8000 FM_EMSYNC_CATCHUP_HIGH_WATER_PCT=75 FM_REDIS_RATE_LIMIT_ENABLED=false node --import tsx --import ./test/_runtimeMetadataEnv.ts --test --test-global-setup=./test/integration/_setup.ts --test-concurrency=1 test/integration/emSyncMixedFleet60Day.integration.ts",
        "lint": "biome check  ./src/ && npm run lint:migrations",
        "lint:migrations": "tsx scripts/lint-migrations.ts",
        "drift:check": "tsx scripts/drift-detector.ts",
        "generate": "tsx scripts/generate/all.ts",
        "generate:gates": "tsx scripts/generate/ci-gates.ts"
    },
    "engines": {
        "node": ">=24.0.0 <25.0.0"
    },
    "keywords": [],
